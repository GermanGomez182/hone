#!/bin/bash
# Runs tests/integration/shell.qml in a throwaway Quickshell instance and
# fails unless every case passes. Needs a Wayland session.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"

# Quickshell only imports QML from inside its config folder, so assemble a
# throwaway one: the harness plus a copy of the plugin's QML and JS.
config=$(mktemp -d)
trap 'rm -rf "$config"' EXIT
cp "$here/shell.qml" "$config/"
mkdir "$config/plugin"
cp "$root"/*.qml "$root"/*.js "$config/plugin/"

output=$(HONE_FAKES="$here/fake" timeout 60 qs -p "$config" 2>&1 | sed 's/\x1b\[[0-9;]*m//g' || true)
results=$(grep -o "HONE-TEST .*" <<<"$output" || true)

echo "$results"
if ! grep -q "HONE-TEST DONE" <<<"$results"; then
  echo "integration harness did not finish; Quickshell said:" >&2
  grep -E "WARN|ERROR|rror" <<<"$output" | head -20 >&2
  exit 1
fi
if grep -q "HONE-TEST FAIL" <<<"$results"; then exit 1; fi
